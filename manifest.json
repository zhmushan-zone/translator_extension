{
  "manifest_version": 3,
  "name": "极简翻译",
  "version": "1.3.0",
  "description": "划词翻译, 英汉互译, 极简",
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://translate.volcengine.com/*",
    "https://transmart.qq.com/*",
    "https://cn.bing.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-translation": {
      "description": "开启/关闭划词翻译"
    }
  }
}
