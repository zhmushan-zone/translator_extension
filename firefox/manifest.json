{
  "manifest_version": 2,
  "name": "Translator Extension",
  "version": "1.2.0",
  "description": "划词翻译, 英汉互译, 极简",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "https://translate.volcengine.com/*",
    "https://transmart.qq.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main.js"],
      "all_frames": true
    }
  ]
}
